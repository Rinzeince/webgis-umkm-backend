## =============================================================================
## WebGIS SIGAP UMKM KBB — Environment Configuration Template
## Salin file ini ke .env dan sesuaikan nilainya
## =============================================================================

APP_NAME="SIGAP UMKM KBB"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =============================================================================
# DATABASE CONFIGURATION
# Driver yang didukung: mariadb | mysql | sqlite
# =============================================================================
# Opsi A: MariaDB di dalam EC2 (Paling Hemat $0 / 100% Free Tier)
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=webgis_umkm
# DB_USERNAME=webgis_user
# DB_PASSWORD=your_secure_password
#
# Opsi B: AWS RDS MariaDB 10.11/11.4 LTS atau MySQL 8.4 LTS (Free Tier db.t3.micro)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webgis_umkm
DB_USERNAME=root
DB_PASSWORD=

# =============================================================================
# SESSION, CACHE, QUEUE
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# =============================================================================
# FILESYSTEM & STORAGE
# =============================================================================
# Local disk untuk file internal
FILESYSTEM_DISK=local

# ML Analysis chart output: s3 (produksi) | local (development)
# Jika 's3', grafik elbow.png, silhouette.png, scatter_cluster.png diunggah ke AWS S3
ANALYSIS_STORAGE_DRIVER=local

# =============================================================================
# AWS S3 — Cloud Storage (Free Tier: 5GB storage, 20K GET, 2K PUT per bulan)
# Region Jakarta: ap-southeast-3 | Singapura: ap-southeast-1
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=sigap-umkm-storage
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# PYTHON ML SERVICE
# Path binary Python virtualenv
# - Local Windows : biarkan kosong (auto-detect)
# - EC2 Linux Prod: /var/www/webgis-umkm-be/ml-service/venv/bin/python3
# =============================================================================
PYTHON_PATH=

# =============================================================================
# MAIL (Opsional)
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
